POSTGRES_USER=orgcomms
POSTGRES_PASSWORD=GENERATE_48
POSTGRES_DB=orgcomms_prod
# Optional - Postgres connection pool sizing (api/src/server.js). Defaults
# shown are node-postgres's own defaults, made explicit/documented rather
# than left as an invisible library default. Raise DB_POOL_MAX only if
# you've also checked Postgres's own max_connections has headroom for it
# (this service isn't the only thing that connects - migrate.js, any
# psql/backup tooling, etc all count against the same limit).
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
REDIS_PASSWORD=GENERATE_REDIS
JWT_SECRET=GENERATE_JWT
ENCRYPTION_KEY=GENERATE_ENC
# Server-to-server auth for internal-only routes (e.g. hermes calling api's
# /internal/content-variants/:id/publish) - generate like JWT_SECRET/
# ENCRYPTION_KEY, e.g. `openssl rand -hex 32`. Never exposed to a browser.
INTERNAL_API_SECRET=GENERATE_INTERNAL
# Optional - Sarvam AI, used server-side to classify an inbound lead
# message as a genuine product inquiry or not (see README.md "Hardening
# notes"). Leave unset to run with no message filtering at all (every
# inbound lead's is_inquiry stays NULL/unclassified rather than hidden -
# the app behaves identically either way, just without the filter).
# Get a key at https://www.sarvam.ai - SARVAM_MODEL defaults to
# "sarvam-105b" if unset.
# SARVAM_API_KEY=
# SARVAM_MODEL=sarvam-105b
API_DOMAIN=api.yourdomain.com
APP_DOMAIN=app.yourdomain.com
# Optional: extra allowed browser origins beyond https://$APP_DOMAIN,
# comma-separated, full origin incl. scheme (e.g. staging/local dev).
# CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,http://localhost:5173
# true (or unset) until you've created your Super Admin via the Sign Up
# screen, then set to false to close POST /auth/signup outright.
SIGNUP_ENABLED=true

# Optional - error tracking (Sentry). Leave unset to run with no error
# tracking at all (the app behaves identically either way - see
# api/src/error-tracking.js). Set to a real Sentry DSN to have unhandled
# 500s (server.js's serverError()) reported there with stack traces.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional: how many days of local daily backups postgres-backup keeps
# before pruning (default 7 if unset).
# BACKUP_RETENTION_DAYS=7
# Optional: ship each backup off this VPS via rclone after it succeeds
# locally - see README.md "Hardening notes" for the Dockerfile + rclone.conf
# setup this also requires. Leave unset for local-only backups (today's
# default behavior).
# RCLONE_REMOTE=s3:my-bucket/orgcomms-backups
