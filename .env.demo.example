# Demo deployment of OctaveGrowthIntelligence - see DEMO.md for the full
# how-to-stand-this-up guide. This file mirrors .env.vps.example, with the
# differences called out below. Copy to .env.demo, fill in the GENERATE_*
# values, and use it with docker-compose.vps.yml (same compose file as a
# real deployment - the demo is the real app, just seeded with sample data
# and pointed at a disposable database).

POSTGRES_USER=orgcomms
POSTGRES_PASSWORD=GENERATE_48
POSTGRES_DB=orgcomms_demo
REDIS_PASSWORD=GENERATE_REDIS
JWT_SECRET=GENERATE_JWT
# Required - seed-demo.js (api/scripts/seed-demo.js) uses this to encrypt
# the (fake) channel credentials it writes, via the app's own
# api/src/crypto-secrets.js - exactly the same code path a real deployment
# uses for real channel secrets. Generate like any deployment, e.g.
# `openssl rand -hex 32`.
ENCRYPTION_KEY=GENERATE_ENC
INTERNAL_API_SECRET=GENERATE_INTERNAL

# Required if this demo runs alongside a real/production deployment of
# this same compose file on the same VPS (or alongside another demo
# deployment) - without these, both stacks try to bind the same
# 127.0.0.1:<port> on the host and the second one up fails with "port is
# already allocated" (see docker-compose.vps.yml's `ports:` entries).
# Pick values that aren't already in use on this host - any free ports
# work, these are just a conventional offset from the production
# defaults (5432/8300/8301/8305).
POSTGRES_HOST_PORT=5532
API_HOST_PORT=8400
API_METRICS_HOST_PORT=8401
FRONTEND_HOST_PORT=8405

# Seeds the demo data (api/scripts/seed-demo.js) automatically on the
# api container's first startup - no shell/terminal into the container
# needed. Idempotent - safe to leave true across redeploys/restarts; it
# detects the demo admin already exists after the first run and skips.
RUN_DEMO_SEED=true
# Optional - override the shared password seed-demo.js sets for every
# demo account (default OctaveDemo#2026 if left unset).
# DEMO_PASSWORD=

# Intentionally left unset for the demo - see DEMO.md "What's real vs.
# simulated". With these unset, the app behaves exactly as it does for any
# deployment that hasn't configured them: the relevant feature is honestly
# unavailable rather than faked. The demo's historical records (past calls,
# past discovery runs) were written directly into the database by
# seed-demo.js, so they display correctly either way.
# SARVAM_API_KEY=
# SARVAM_VOICE_ORG_ID=
# SARVAM_VOICE_WORKSPACE_ID=
# SARVAM_VOICE_APP_ID=
# SARVAM_VOICE_APP_VERSION=1
# SARVAM_VOICE_CONNECTION_ID=
# SARVAM_VOICE_AGENT_PHONE_NUMBER=
# SARVAM_VOICE_WEBHOOK_SECRET=
# APIFY_API_TOKEN=

API_DOMAIN=demo-api.yourdomain.com
APP_DOMAIN=demo.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,http://localhost:5173

# Keep signup closed on the demo - seed-demo.js creates the demo users
# directly in the database and marks the one-shot signup flag
# (system_flags.signup_used) used itself, so there's no need (and no
# reason) to expose POST /auth/signup on a shared demo.
SIGNUP_ENABLED=false

# SENTRY_DSN=
# BACKUP_RETENTION_DAYS=1
# RCLONE_REMOTE=
