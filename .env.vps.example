POSTGRES_USER=orgcomms
POSTGRES_PASSWORD=GENERATE_48
POSTGRES_DB=orgcomms_prod
REDIS_PASSWORD=GENERATE_REDIS
JWT_SECRET=GENERATE_JWT
ENCRYPTION_KEY=GENERATE_ENC
# Server-to-server auth for internal-only routes (e.g. hermes calling api's
# /internal/leads/:id/auto-run-agent) - generate like JWT_SECRET/
# ENCRYPTION_KEY, e.g. `openssl rand -hex 32`. Never exposed to a browser.
INTERNAL_API_SECRET=GENERATE_INTERNAL
API_DOMAIN=api.yourdomain.com
APP_DOMAIN=app.yourdomain.com
# Optional: extra allowed browser origins beyond https://$APP_DOMAIN,
# comma-separated, full origin incl. scheme (e.g. staging/local dev).
# CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,http://localhost:5173
# true (or unset) until you've created your Super Admin via the Sign Up
# screen, then set to false to close POST /auth/signup outright.
SIGNUP_ENABLED=true
# Optional: how many days of local daily backups postgres-backup keeps
# before pruning (default 7 if unset).
# BACKUP_RETENTION_DAYS=7
# Optional: ship each backup off this VPS via rclone after it succeeds
# locally - see README.md "Hardening notes" for the Dockerfile + rclone.conf
# setup this also requires. Leave unset for local-only backups (today's
# default behavior).
# RCLONE_REMOTE=s3:my-bucket/orgcomms-backups
