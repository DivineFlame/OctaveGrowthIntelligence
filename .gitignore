# Dependencies
node_modules/
**/node_modules/

# Environment / secrets
.env
.env.*
!.env.*.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Logs
*.log
npm-debug.log*
logs/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Build output
dist/
build/

# Generated by frontend/app's build (scripts/assemble.js splices the built
# React app into frontend/overlay.html) - Docker builds this fresh every
# time (see frontend/Dockerfile), so a committed copy would just be stale
# build output waiting to drift from its real source (frontend/app/ +
# frontend/overlay.html). Build it locally with `cd frontend/app && npm run
# build` when you need it on disk, e.g. to run scripts/gen-csp-hashes.sh.
frontend/index.html
frontend/assets/

# Docker / Postgres runtime data
postgres/data/
**/pgdata/
*.pid

# Misc
*.tmp
*.bak
